function WorkingZone({ template }: { template: TentTemplate }) {
  const ratio = template.width / template.depth;
  const zoneWidth = 860;
  const zoneHeight = Math.round(zoneWidth / ratio);

  const frontZoneWidth = template.id === "tent-25x15" ? "22%" : "20%";
  const centerZoneWidth = template.id === "tent-25x15" ? "56%" : "60%";
  const rearZoneWidth = template.id === "tent-25x15" ? "22%" : "20%";

  return (
    <div
      style={{
        borderRadius: "24px",
        border: "1px solid rgba(96,165,250,0.18)",
        background: "linear-gradient(180deg, rgba(59,130,246,0.14), rgba(2,6,23,0.58))",
        padding: "18px",
      }}
    >
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: "12px",
          marginBottom: "14px",
          color: "rgba(255,255,255,0.80)",
          fontSize: "14px",
          fontWeight: 600,
        }}
      >
        <span>Front / כניסה</span>
        <span>{template.width}m × {template.depth}m</span>
        <span>Rear / אחורי</span>
      </div>

      <div
        style={{
          position: "relative",
          width: "100%",
          maxWidth: `${zoneWidth}px`,
          height: `${zoneHeight}px`,
          margin: "0 auto",
          borderRadius: "28px",
          border: "2px solid rgba(110,231,255,0.42)",
          background:
            "linear-gradient(180deg, rgba(8,47,73,0.9), rgba(4,14,32,0.96))",
          overflow: "hidden",
          boxShadow: "inset 0 0 0 1px rgba(255,255,255,0.04), 0 20px 50px rgba(0,0,0,0.22)",
        }}
      >
        <div
          style={{
            position: "absolute",
            inset: "16px",
            border: "1px dashed rgba(191,219,254,0.20)",
            borderRadius: "22px",
            pointerEvents: "none",
          }}
        />

        <div
          style={{
            position: "absolute",
            top: 0,
            bottom: 0,
            left: frontZoneWidth,
            width: "1px",
            background: "rgba(110,231,255,0.26)",
          }}
        />
        <div
          style={{
            position: "absolute",
            top: 0,
            bottom: 0,
            right: rearZoneWidth,
            width: "1px",
            background: "rgba(110,231,255,0.26)",
          }}
        />

        <div
          style={{
            position: "absolute",
            left: "50%",
            top: 0,
            bottom: 0,
            width: "1px",
            transform: "translateX(-50%)",
            background: "rgba(255,255,255,0.16)",
          }}
        />

        <ZoneLabel
          title="כניסה / קבלת קהל"
          subtitle="Reception / Entry"
          left="2%"
          top="8%"
          width={frontZoneWidth}
          height="84%"
        />
        <ZoneLabel
          title="אזור מוצגים מרכזי"
          subtitle="Main Exhibition Zone"
          left={frontZoneWidth}
          top="8%"
          width={centerZoneWidth}
          height="84%"
          highlight
        />
        <ZoneLabel
          title="אזור אחורי / תפעול"
          subtitle="Back / Support"
          left={`calc(100% - ${rearZoneWidth})`}
          top="8%"
          width={rearZoneWidth}
          height="84%"
        />

        <div
          style={{
            position: "absolute",
            left: "6%",
            right: "6%",
            bottom: "12%",
            height: "18%",
            borderRadius: "18px",
            border: "1px dashed rgba(96,165,250,0.28)",
            background: "rgba(37,99,235,0.10)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            color: "rgba(219,234,254,0.78)",
            fontSize: "14px",
            fontWeight: 700,
          }}
        >
          שטיח / Carpet zone
        </div>

        <div
          style={{
            position: "absolute",
            left: "8%",
            top: "6%",
            color: "#bdf6ff",
            fontSize: "12px",
            fontWeight: 800,
            letterSpacing: "0.04em",
          }}
        >
          FRONT
        </div>

        <div
          style={{
            position: "absolute",
            right: "8%",
            top: "6%",
            color: "rgba(255,255,255,0.68)",
            fontSize: "12px",
            fontWeight: 800,
            letterSpacing: "0.04em",
          }}
        >
          REAR
        </div>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
          gap: "12px",
          marginTop: "14px",
        }}
      >
        <MetricBox label="Suggested Front Zone" value="Entry / Branding" />
        <MetricBox label="Suggested Center Zone" value="Main Assets" />
        <MetricBox label="Suggested Rear Zone" value="Support / Storage" />
      </div>
    </div>
  );
}

function ZoneLabel({
  title,
  subtitle,
  left,
  top,
  width,
  height,
  highlight = false,
}: {
  title: string;
  subtitle: string;
  left: string;
  top: string;
  width: string;
  height: string;
  highlight?: boolean;
}) {
  return (
    <div
      style={{
        position: "absolute",
        left,
        top,
        width,
        height,
        padding: "18px 14px",
        boxSizing: "border-box",
      }}
    >
      <div
        style={{
          width: "100%",
          height: "100%",
          borderRadius: "20px",
          border: highlight
            ? "1px solid rgba(110,231,255,0.34)"
            : "1px solid rgba(255,255,255,0.10)",
          background: highlight
            ? "rgba(110,231,255,0.10)"
            : "rgba(255,255,255,0.03)",
          display: "flex",
          flexDirection: "column",
          justifyContent: "space-between",
          padding: "16px 14px",
          boxSizing: "border-box",
        }}
      >
        <div>
          <div
            style={{
              fontSize: "16px",
              fontWeight: 800,
              color: "white",
              marginBottom: "6px",
              lineHeight: 1.15,
            }}
          >
            {title}
          </div>
          <div
            style={{
              fontSize: "12px",
              color: "rgba(255,255,255,0.66)",
              lineHeight: 1.4,
            }}
          >
            {subtitle}
          </div>
        </div>

        <div
          style={{
            fontSize: "11px",
            color: highlight ? "#bdf6ff" : "rgba(255,255,255,0.56)",
            fontWeight: 700,
            letterSpacing: "0.03em",
          }}
        >
          BASE ZONE
        </div>
      </div>
    </div>
  );
}

