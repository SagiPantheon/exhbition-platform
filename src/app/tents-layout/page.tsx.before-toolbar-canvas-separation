function TopPill({
  label,
  active = false,
}: {
  label: string;
  active?: boolean;
}) {
  return (
    <div
      style={{
        padding: "8px 12px",
        borderRadius: "12px",
        border: active
          ? "1px solid rgba(56,189,248,0.48)"
          : "1px solid rgba(148,163,184,0.18)",
        background: active
          ? "rgba(34,211,238,0.14)"
          : "rgba(255,255,255,0.03)",
        color: "#f8fbff",
        fontSize: "13px",
        fontWeight: 700,
        whiteSpace: "nowrap",
      }}
    >
      {label}
    </div>
  );
}

function ToolButton({
  label,
  active = false,
}: {
