const TENT_MODEL_PATH = "/models/inventory/tent-20-30-iai-blue-01.glb";

function TentModel3D() {
  const gltf = useGLTF(TENT_MODEL_PATH);
  const cloned = useMemo(() => gltf.scene.clone(true), [gltf.scene]);

  return (
    <primitive
      object={cloned}
      position={[0, -1.15, 0]}
      rotation={[0, 0.62, 0]}
      scale={1.55}
    />
  );
}

